{
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git pull:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git push:*)", "Bash(git stash:*)",
      "Bash(git log:*)", "Bash(git diff:*)", "Bash(gh pr create:*)",
      "Bash(npx --yes html-validate:*)", "Bash(mkdir:*)", "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git reset --hard:*)", "Bash(rm -rf:*)"
    ]
  }
}
