{
  "name": "aquarii-templates",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./templates",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "templates.aquariit.com", "custom_domain": true }
  ]
}
